# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/takeitfree

# Server Configuration
NODE_ENV=development
PORT=5000

# Supabase Configuration (Optional - if using Supabase)
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OAuth Configuration (Optional)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
EXPO_PUBLIC_GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# API Configuration (for mobile/web on different networks)
# Leave empty to use default (localhost:5000 for server, window.location.origin for web)
# For local network testing: http://192.168.1.100:5000/api
EXPO_PUBLIC_API_URL=

